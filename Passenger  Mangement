    if (si == -1) { printf("Schedule not found.\n"); return; }
    printf("\nSeat map for %s at %s on %s\n", trains[schedules[si].trainIndex].trainName,
           schedules[si].departureTime, schedules[si].travelDate);
    printf("     "); for (c = 0; c < SEAT_COLS; c++) printf("%3d", c + 1); printf("\n");
    for (r = 0; r < SEAT_ROWS; r++)
    {
        printf("Row %d", r + 1);
        for (c = 0; c < SEAT_COLS; c++) {
            int seatNumber = r * SEAT_COLS + c;
            if (seatNumber >= trains[schedules[si].trainIndex].totalSeats) printf("%3s", "-");
            else printf("%3s", schedules[si].seats[r][c] == 0 ? "O" : "X");
        }
        printf("\n");
    }
    printf("O = Available, X = Booked\n");
}

void sortCustomersByBooking(int count, int byDate)
{
    (void)count; /* bookings are sorted independently of the customer array */
    int idx[MAX_BOOKINGS], n = 0, i, j, temp;
    for (i = 0; i < bookingCount; i++) if (bookings[i].active) idx[n++] = i;
    for (i = 0; i < n - 1; i++) for (j = i + 1; j < n; j++)
    {
        int swap = 0;
        if (byDate)
        {
            int a = bookings[idx[i]].scheduleIndex, b = bookings[idx[j]].scheduleIndex;
            int cmp = strcmp(schedules[a].travelDate, schedules[b].travelDate);
            if (cmp > 0 || (cmp == 0 && strcmp(schedules[a].departureTime, schedules[b].departureTime) > 0)) swap = 1;
        }
        else
        {
            int a = schedules[bookings[idx[i]].scheduleIndex].trainIndex;
            int b = schedules[bookings[idx[j]].scheduleIndex].trainIndex;
            if (trains[a].trainNumber > trains[b].trainNumber) swap = 1;
        }
        if (swap) { temp = idx[i]; idx[i] = idx[j]; idx[j] = temp; }
    }
    printf("\n===== CUSTOMER BOOKINGS SORTED BY %s =====\n", byDate ? "DATE" : "TRAIN");
    if (n == 0) { printf("No bookings found.\n"); return; }
    for (i = 0; i < n; i++)
    {
        struct Booking *b = &bookings[idx[i]];
        int si = b->scheduleIndex, ti = schedules[si].trainIndex;
        printf("Customer ID: %d | Booking ID: %d | Train: %s (%d) | Date: %s | Time: %s | Route: %s -> %s\n",
               b->customerId, b->bookingId, trains[ti].trainName, trains[ti].trainNumber,
               schedules[si].travelDate, schedules[si].departureTime, b->source, b->destination);
    }
}

void services(struct passenger *p)
{
    if(p->booked == 0)
    {
        printf("\nBook your ticket first!\n");
        return;
    }

    printf("\n--- SERVICES ---\n");

    printf("1. Food - Rs. 500\n");
    printf("0. No Service\n");

    printf("Choose Service: ");
    scanf("%d",&p->foodChoice);

    if(p->foodChoice==1)
        p->serviceCost=500;
    else
    {
        p->foodChoice=0;
        p->serviceCost=0;
    }
}
void billing(struct passenger *p)
{
    float discount = 0;
    if(p->booked == 0)
    {
        printf("\nBook your ticket first!\n");
        return;
    }
    printf("\n--- BILLING ---\n");
    printf("Ticket Fare: Rs. %.2f\n", p->Fare);
    printf("Service Cost: Rs. %.2f\n", p->serviceCost);
    p->totalBill = p->Fare + p->serviceCost;
    if(p->age >= 60 || p->age <= 10)
    {
        discount = p->totalBill * 0.50;
        printf("You get 50%% discount!\n");
    }
    p->totalBill = p->totalBill - discount;
    p->gst = p->totalBill * 0.20;
    p->finalBill = p->totalBill + p->gst;
    printf("\nSubtotal after discount: Rs. %.2f",p->totalBill);
    printf("\nGST (20%%): Rs. %.2f", p->gst);
    printf("\nFinal Amount: Rs. %.2f\n",p->finalBill);
}

void receipt(struct passenger *customer)
{
    int bi = findBookingByCustomer(customer->customerId);
    struct Booking *b;
    int si, ti;
    if (bi == -1) { printf("\nNo booking found!\n"); return; }
    b = &bookings[bi]; si = b->scheduleIndex; ti = schedules[si].trainIndex;
    printf("\n========== RAILWAY RECEIPT ==========\n");
    printf("Customer ID: %d\nName: %s\nPhone: %s\nBooking ID: %d\n", customer->customerId, customer->name, customer->phone, b->bookingId);
    printf("Train: %s (%d)\nDate: %s\nDeparture Time: %s\n", trains[ti].trainName, trains[ti].trainNumber, schedules[si].travelDate, schedules[si].departureTime);
    printf("Source: %s\nDestination: %s\nSeat: Row %d, Seat %d\n", b->source, b->destination, b->seatRow, b->seatColumn);
    printf("Ticket Fare: Rs. %.2f\nService Cost: Rs. %.2f\nSubtotal after discount: Rs. %.2f\nGST: Rs. %.2f\nFinal Amount: Rs. %.2f\n",
           customer->Fare, customer->serviceCost, customer->totalBill, customer->gst, customer->finalBill);
    printf("=====================================\n");
}

void customerInfo(struct passenger *p, int id)
{
    // clear any leftover data (important after a record was deleted)
    memset(p, 0, sizeof(struct passenger));

    p->customerId = id;

    printf("Enter passenger name: ");
    scanf(" %79[^\n]", p->name);

    do
    {
        printf("Enter age: ");
        scanf("%d",&p->age);
        if (p->age <= 0 || p->age > 120)
        {
            printf("Invalid Age! Try again.\n");
        }
    } while (p->age <= 0 || p->age > 120);

    do
    {
        printf("Enter phone number: ");
        scanf("%19s",p->phone);
        if (!phonechk(p->phone))
        {
            printf("Invalid Phone Number! Try again.\n");
        }
    } while (!phonechk(p->phone));

    do
    {
        printf("Enter email: ");
        scanf("%49s",p->email);
        if (!emailchk(p->email))
        {
            printf("Invalid Email! Try again.\n");
        }
    } while (!emailchk(p->email));

    printf("\nRegistration successful!\n");
    printf("Customer ID: %d\n",p->customerId);
}

int findPassenger(struct passenger p[],int count,int id)
{
    int i;

    for(i = 0;i<count;i++)
    {
        if (p[i].customerId==id)
        {
            return i;
        }
    }
    return -1;
}

