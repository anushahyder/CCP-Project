void booking(struct passenger *customer)
{
    char source[30], destination[30], date[11];
    int i, j, k, sourcePos, destPos, fare, chosenSchedule = -1, seat = -1, matches = 0;
    int customerIndex = findBookingByCustomer(customer->customerId);
    if (customerIndex != -1) { printf("\nCustomer already has an active booking!\n"); return; }
    if (bookingCount >= MAX_BOOKINGS) { printf("Booking limit reached!\n"); return; }

    printf("\n===== TRAIN BOOKING =====\n");
    printf("Enter source station: "); scanf(" %29[^\n]", source);
    printf("Enter destination station: "); scanf(" %29[^\n]", destination);
    printf("Enter travel date (YYYY-MM-DD): "); scanf("%10s", date);

    printf("\n===== TRAINS DEPARTING ON %s =====\n", date);
    for (i = 0; i < scheduleCount; i++)
    {
        if (!schedules[i].active || strcmp(schedules[i].travelDate, date) != 0) continue;
        sourcePos = destPos = -1;
        for (j = 0; j < trains[schedules[i].trainIndex].stationCount; j++)
        {
            if (strcmp(trains[schedules[i].trainIndex].stations[j], source) == 0) sourcePos = j;
            if (strcmp(trains[schedules[i].trainIndex].stations[j], destination) == 0) destPos = j;
        }
        if (sourcePos >= 0 && destPos > sourcePos && scheduleAvailableSeats(i) > 0)
        {
            fare = (destPos - sourcePos) * trains[schedules[i].trainIndex].farePerStation;
            printf("Schedule ID: %d | Train: %s (%d) | Time: %s | Fare: Rs.%d | Seats: %d\n",
                   schedules[i].scheduleId, trains[schedules[i].trainIndex].trainName,
                   trains[schedules[i].trainIndex].trainNumber, schedules[i].departureTime,
                   fare, scheduleAvailableSeats(i));
            matches++;
        }
    }

    if (matches == 0) {
        printf("No train schedule is available for this route and date.\n");
        return;
    }
    printf("Enter Schedule ID to book (0 to cancel): ");
    if (scanf("%d", &k) != 1) { printf("Invalid schedule ID.\n"); return; }
    if (k == 0) { printf("Booking cancelled.\n"); return; }
    for (i = 0; i < scheduleCount; i++) if (schedules[i].active && schedules[i].scheduleId == k && strcmp(schedules[i].travelDate, date) == 0) { chosenSchedule = i; break; }
    if (chosenSchedule == -1) { printf("Invalid schedule selection.\n"); return; }

    i = schedules[chosenSchedule].trainIndex;
    sourcePos = destPos = -1;
    for (j = 0; j < trains[i].stationCount; j++)
    {
        if (strcmp(trains[i].stations[j], source) == 0) sourcePos = j;
        if (strcmp(trains[i].stations[j], destination) == 0) destPos = j;
    }
    if (sourcePos < 0 || destPos <= sourcePos || scheduleAvailableSeats(chosenSchedule) <= 0)
    { printf("Selected train does not serve this route or has no seats.\n"); return; }
    fare = (destPos - sourcePos) * trains[i].farePerStation;

    // Find the first free seat in the 2D seat matrix.
    for (j = 0; j < SEAT_ROWS && seat == -1; j++)
        for (k = 0; k < SEAT_COLS; k++)
            if (schedules[chosenSchedule].seats[j][k] == 0) { seat = j * SEAT_COLS + k; break; }
    if (seat == -1 || seat >= trains[i].totalSeats) { printf("No seat available in this schedule.\n"); return; }

    printf("\nPassenger: %s\nTrain: %s\nDate: %s\nTime: %s\nRoute: %s to %s\nFare: Rs.%d\nSeat: Row %d, Seat %d\n",
           customer->name, trains[i].trainName, date, schedules[chosenSchedule].departureTime,
           source, destination, fare, seat / SEAT_COLS + 1, seat % SEAT_COLS + 1);
    printf("Confirm booking (1=Yes, 0=No): "); scanf("%d", &k);
    if (k != 1) { printf("Booking cancelled.\n"); return; }

    bookings[bookingCount].bookingId = nextBookingID++;
    bookings[bookingCount].customerId = customer->customerId;
    bookings[bookingCount].scheduleIndex = chosenSchedule;
    strcpy(bookings[bookingCount].source, source);
    strcpy(bookings[bookingCount].destination, destination);
    bookings[bookingCount].seatRow = seat / SEAT_COLS + 1;
    bookings[bookingCount].seatColumn = seat % SEAT_COLS + 1;
    bookings[bookingCount].fare = fare;
    bookings[bookingCount].active = 1;
    schedules[chosenSchedule].seats[seat / SEAT_COLS][seat % SEAT_COLS] = customer->customerId;
    bookingCount++;

    // Keep existing service/billing functions compatible with the separate Booking struct.
    customer->booked = 1;
    customer->trainIndex = i;
    strcpy(customer->trainName, trains[i].trainName);
    strcpy(customer->departure, source);
    strcpy(customer->destination, destination);
    customer->Fare = (float)fare;
    customer->bookingId = bookings[bookingCount - 1].bookingId;
    customer->seatno = seat + 1;
    printf("\nBOOKING SUCCESSFUL! Booking ID: %d\n", customer->bookingId);
}

