//validate phone number
int phonechk(char phone[])
{
    int i;
    if (strlen(phone) != 11)
    {
        return 0;
    }
    if (phone[0] != '0')
    {return 0;}
    for (i = 0; phone[i] != '\0'; i++)
    { if (!isdigit((char)phone[i]))
        {return 0;}
    }
    return 1;
}

//validate email
int emailchk(char email[])
{
    int i;
    int at = -1, dot = -1;
    for (i = 0; email[i] != '\0'; i++)
    {
        if (email[i] == '@')
        {
            if (at != -1)
                return 0;
            at = i;
        }
        if (email[i] == '.')
        {   dot = i;}
    }
    if (at <= 0 || dot <= at + 1 || email[dot + 1] == '\0')
    {
        return 0;
    }
    return 1;
}

// ERROR CHECK FUNCTION
int errorChk(char *str1, char *str2)
{
    int check = strcmp(str1, str2);
    if (check == 0)
    { return 1;}
    else
    { return 0;}
}

// PASSWORD VALIDATION FUNCTION
int passchk(char *pass)
{
    int i;
    int fl = 0, fn = 0, fc = 0, fu = 0;
    if (strlen(pass) < 8)
    { return 0;}
    for (i = 0; pass[i] != '\0'; i++)
    {
        if (isdigit((char)pass[i]))
            fn = 1;
        if (islower((char)pass[i]))
            fl = 1;
        if (isupper(( char)pass[i]))
            fu = 1;
        if (pass[i] == '!' || pass[i] == '@' ||pass[i] == '#' || pass[i] == '$' || pass[i] == '%' || pass[i] == '^' ||pass[i] == '&' || pass[i] == '*' ||pass[i] == '?')
        {
            fc = 1;
        }
    }
    if (fl && fn && fc && fu)
    { return 1;}
    return 0;
}

// USERNAME VALIDATION FUNCTION
int userchk(char *username)
{
    int i;
    if (strlen(username) <= 5)
    {
        return 0;
    }
    for (i = 0; username[i] != '\0'; i++)
    {
        if (!isalpha((unsigned char)username[i]))
        {
            return 0;
        }
    }
    return 1;
}

