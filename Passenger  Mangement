int scheduleAvailableSeats(int scheduleIndex)
{
    int r, c, used = 0, ti;
    if (scheduleIndex < 0 || scheduleIndex >= scheduleCount) return 0;
    ti = schedules[scheduleIndex].trainIndex;
    if (ti < 0 || ti >= trainCount) return 0;
    for (r = 0; r < SEAT_ROWS; r++)
        for (c = 0; c < SEAT_COLS; c++)
            if (schedules[scheduleIndex].seats[r][c] != 0) used++;
    return trains[ti].totalSeats - used;
}

