    for (i = 0; i < bookingCount; i++)
        if (bookings[i].active && bookings[i].customerId == customerId) return i;
    return -1;
}

void addTrainSchedule(void)
{
    int trainNo, i, found = -1;
    char date[11], timeText[6];
    if (scheduleCount >= MAX_SCHEDULES) {
        printf("Schedule limit reached!\n");
        return;
    }
    if (trainCount == 0) {
        printf("No trains exist. Add a train before creating its schedule.\n");
        return;
    }
    printf("\n===== ADD TRAIN SCHEDULE =====\n");
    printf("Enter train number: ");
    if (scanf("%d", &trainNo) != 1) { printf("Invalid train number.\n"); return; }
    for (i = 0; i < trainCount; i++)
        if (trains[i].trainNumber == trainNo) { found = i; break; }
    if (found == -1) { printf("Train not found. Add the train first.\n"); return; }

    printf("Enter travel date (YYYY-MM-DD): ");
    if (scanf("%10s", date) != 1 || !validDate(date)) {
        printf("Invalid date. Use a real date in YYYY-MM-DD format.\n");
        return;
    }
    printf("Enter departure time (HH:MM, 24-hour): ");
    if (scanf("%5s", timeText) != 1 || !validTime(timeText)) {
        printf("Invalid time. Use HH:MM in 24-hour format.\n");
        return;
    }
    for (i = 0; i < scheduleCount; i++) {
        if (schedules[i].active && schedules[i].trainIndex == found &&
            strcmp(schedules[i].travelDate, date) == 0 &&
            strcmp(schedules[i].departureTime, timeText) == 0) {
            printf("A schedule for this train already exists at that date and time.\n");
            return;
        }
    }
    schedules[scheduleCount].scheduleId = scheduleCount + 1;
    schedules[scheduleCount].trainIndex = found;
    strcpy(schedules[scheduleCount].travelDate, date);
    strcpy(schedules[scheduleCount].departureTime, timeText);
    schedules[scheduleCount].active = 1;
    memset(schedules[scheduleCount].seats, 0, sizeof(schedules[scheduleCount].seats));
    scheduleCount++;
    printf("Train schedule added successfully!\n");
    printf("Returning to main menu...\n");
}

