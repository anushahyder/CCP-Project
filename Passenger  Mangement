// DELETE CUSTOMER RECORD
void deleteCustomer(struct passenger p[], int *count)
{
    int i, j, deleteID, b, r, c;
    printf("\n====== DELETE CUSTOMER ======\n");
    printf("Enter Customer ID to delete: ");
    scanf("%d", &deleteID);

    for (i = 0; i < *count; i++)
    {
        if (p[i].customerId == deleteID)
        {
            // Release the exact seat and deactivate the separate booking.
            for (b = 0; b < bookingCount; b++)
            {
                if (bookings[b].active && bookings[b].customerId == deleteID)
                {
                    int si = bookings[b].scheduleIndex;
                    r = bookings[b].seatRow - 1;
                    c = bookings[b].seatColumn - 1;
                    if (si >= 0 && si < scheduleCount && r >= 0 && r < SEAT_ROWS && c >= 0 && c < SEAT_COLS)
                        schedules[si].seats[r][c] = 0;
                    bookings[b].active = 0;
                }
            }
            for (j = i; j < *count - 1; j++) p[j] = p[j + 1];
            (*count)--;
            printf("\nCustomer Deleted Successfully!\n");
            return;
        }
    }
    printf("\nCustomer ID Not Found!\n");
}

