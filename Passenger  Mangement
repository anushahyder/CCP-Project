// LOGIN FUNCTION
void staffLogin(char *username, char *password)
{
    char user[100];
    char pass[100];
    int attempts;
    int seconds;

    printf("\n====== LOGIN SYSTEM ======\n");
    for (attempts = 1; attempts <= 3; attempts++)
    {
        printf("\nAttempt %d - Username: ", attempts);
        scanf("%99s", user);
        printf("Password: ");
        scanf("%99s", pass);
        if (errorChk(user, username) && errorChk(pass, password))
        {
            printf("\nLogin Successful!\n");
            printf("Welcome %s!\n", username);
            return;
        }

        printf("\nWrong username or password.\n");
    }

    printf("\n====== ACCOUNT LOCKED ======\n");
    printf("Please wait 2 minutes before trying again.\n");

    // TWO-MINUTE COUNTDOWN
    for (seconds = 120; seconds >= 0; seconds--)
    {
        printf("\rTime remaining: %02d:%02d", seconds / 60, seconds % 60);
        fflush(stdout);
        if (seconds > 0)
        {
            waitOneSecond();
        }
    }
    printf("\nTime remaining: 00:00\n");
    printf("You can login now!\n");

    // LOGIN AGAIN AFTER LOCKOUT
    staffLogin(username, password);
}

/* Validate a real calendar date in YYYY-MM-DD format. */
int validDate(const char date[])
{
    int year, month, day, maxDay;
    int i;
    if (strlen(date) != 10 || date[4] != '-' || date[7] != '-') return 0;
    for (i = 0; i < 10; i++)
        if (i != 4 && i != 7 && !isdigit((char)date[i])) return 0;
    if (sscanf(date, "%4d-%2d-%2d", &year, &month, &day) != 3) return 0;
    if (year < 1 || month < 1 || month > 12 || day < 1) return 0;
    if (month == 2)
        maxDay = (year % 400 == 0 || (year % 4 == 0 && year % 100 != 0)) ? 29 : 28;
    else if (month == 4 || month == 6 || month == 9 || month == 11)
        maxDay = 30;
    else
        maxDay = 31;
    return day <= maxDay;
}

int validTime(const char timeText[])
{
    int hour, minute, i;
    if (strlen(timeText) != 5 || timeText[2] != ':') return 0;
    for (i = 0; i < 5; i++)
        if (i != 2 && !isdigit((unsigned char)timeText[i])) return 0;
    if (sscanf(timeText, "%2d:%2d", &hour, &minute) != 2) return 0;
    return hour >= 0 && hour <= 23 && minute >= 0 && minute <= 59;
}

